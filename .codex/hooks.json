{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \".codex\\hooks\\session_start_superpowers.ps1\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \".codex\\hooks\\session_start_opensrc.ps1\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "serena-hooks activate --client=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Shell|Bash|shell_command|functions.shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \".codex\\hooks\\pre_tool_use_policy.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Shell|Bash|shell_command|functions.shell_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks remind --client=codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__node_repl__js|node_repl.js|js",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \".codex\\hooks\\pre_tool_use_chrome.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Shell|Bash|shell_command|functions.shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \".codex\\hooks\\post_tool_use_opensrc_serena.ps1\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
